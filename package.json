{
  "name": "dtp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Dhaka Tesla Pool — Express + PostgreSQL backend (pooling, per-leg fares, seat locking)",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "db:setup": "npm run migrate && npm run seed",
    "db:setup:prod": "npm run migrate:prod && npm run seed:prod",
    "db:check": "tsx scripts/check-db.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
