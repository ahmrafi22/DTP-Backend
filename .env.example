# PostgreSQL (Neon or local). Never commit the real values.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Auth
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Server
PORT=4000
CORS_ORIGIN=*

# Rate limit for POST /rides/request (per passenger)
RATE_LIMIT_REQUESTS_MAX=5
RATE_LIMIT_REQUESTS_WINDOW_MS=60000
